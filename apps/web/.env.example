# mdlook 账户与个人配置后端（blog-system，本地 context-path 为 /shiyi）。
VITE_ACCOUNT_API_URL=http://localhost:8800/shiyi

# 原 md-api 能力后端：图床、微信图片转换、主题、分享与文档同步。
VITE_CAPABILITY_API_URL=http://localhost:8787

# 迁移兼容：旧部署可继续使用 VITE_SYNC_API_URL 或 VITE_MD_API_URL；
# 分离部署不要再用一个 VITE_MD_API_URL 同时表示两个后端。
# VITE_SYNC_API_URL=http://localhost:8787
# VITE_MD_API_URL=

# 是否在 UI 显示账户入口（Footer 与移动端菜单）。
VITE_ACCOUNT_UI_ENABLED=true

# 可选：自有 Google Analytics Measurement ID；留空则完全不注入统计脚本。
VITE_GOOGLE_ANALYTICS_ID=

# 是否在 UI 显示云同步入口。默认：已配置 API 即显示（可被下方 false 关闭）。
VITE_SYNC_UI_ENABLED=false

# 是否在 UI 显示 AI 助手、排版与图片能力。
VITE_AI_UI_ENABLED=true

# 爱发电创作者主页（Pro 升级跳转），例如 https://ifdian.net/a/doocs
VITE_AFDIAN_PAGE_URL=

# 爱发电下单页域名，与主页保持一致即可
VITE_AFDIAN_ORDER_BASE=https://ifdian.net

# 默认图床是否经能力后端上传（需与 api wrangler.toml 的 UPLOAD_ENABLED 同步）
VITE_UPLOAD_VIA_API=true

# 「帮助 → 下载 Mac 版」跳转的下载页地址，随部署而异。
# 留空（默认）则隐藏该菜单项，不会留下死链。
VITE_DOWNLOAD_PAGE_URL=
