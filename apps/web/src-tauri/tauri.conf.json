{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mdlook",
  "version": "0.1.13",
  "identifier": "com.mdlook.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173/md/",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "TAURI=1 pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "mdlook",
        "width": 1280,
        "height": 820,
        "minWidth": 860,
        "minHeight": 600,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "category": "Productivity",
    "copyright": "mdlook. Based on doocs/md; upstream copyright retained under WTFPL.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "description": "Markdown document",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ]
  }
}
