{
  "name": "mdlook",
  "type": "module",
  "version": "2.2.0",
  "private": false,
  "description": "mdlook | 面向 Markdown 写作者的网页与 Mac 一体化编辑、预览和公众号排版工具",
  "license": "WTFPL",
  "homepage": "https://github.com/mxx1111/mdlook",
  "repository": {
    "type": "git",
    "url": "https://github.com/mxx1111/mdlook"
  },
  "bugs": {
    "url": "https://github.com/mxx1111/mdlook/issues"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "start": "pnpm web dev",
    "web": "pnpm --filter @md/web",
    "vscode": "pnpm --prefix ./apps/vscode",
    "vscode:test": "pnpm --prefix ./apps/vscode test",
    "mcp": "pnpm --filter @md/mcp-server",
    "api": "pnpm --filter @md/api",
    "cli": "pnpm --filter @doocs/md-cli",
    "build:cli": "pnpm web build && npx shx rm -rf packages/md-cli/dist && npx shx rm -rf dist/**/*.map && npx shx cp -r apps/web/dist packages/md-cli/ && cd packages/md-cli && npm pack",
    "release:cli": "node ./scripts/release.js",
    "lint": "eslint . --fix",
    "type-check": "pnpm --filter @md/web exec vue-tsc --noEmit",
    "postinstall": "simple-git-hooks",
    "inspector": "pnpx node-modules-inspector",
    "utools:package": "node ./scripts/package-utools.mjs",
    "desktop:release": "node ./scripts/release-desktop.mjs",
    "desktop:deploy": "bash ./scripts/deploy-desktop-release.sh",
    "link-claude-skills": "node ./scripts/link-claude-skills.mjs"
  },
  "dependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@types/node": "^25.9.3",
    "archiver": "^8.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "eslint-plugin-format": "^2.0.1",
    "npm-run-all2": "^9.0.3",
    "prettier": "2.8.8",
    "shx": "^0.4.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~6.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
